{
  "name": "siyuan-latex-paste",
  "version": "1.0.0",
  "private": true,
  "description": "SiYuan plugin: math formulas in and out — paste them as native formulas, copy them as Markdown",
  "author": "clock-05, DeepSeek",
  "scripts": {
    "dev": "node scripts/build.mjs --watch",
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node scripts/test.mjs",
    "verify": "npm run typecheck && npm test"
  },
  "dependencies": {
    "turndown": "^7.2.0",
    "turndown-plugin-gfm": "^1.0.2"
  },
  "devDependencies": {
    "@types/turndown": "^5.0.5",
    "esbuild": "^0.24.0",
    "jsdom": "^30.1.3",
    "typescript": "^5.7.0"
  }
}
